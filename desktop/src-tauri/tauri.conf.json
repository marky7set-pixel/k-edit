{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "K-Edit",
  "version": "1.0.0",
  "identifier": "ir.kelid.kedit",
  "build": { "frontendDist": "../../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "K-Edit · ادیت کلید",
        "url": "desktop.html",
        "width": 1380,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Kelid",
    "shortDescription": "K-Edit",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
